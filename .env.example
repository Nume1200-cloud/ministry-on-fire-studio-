# Copy these into Vercel → Project → Settings → Environment Variables.
# Never put real keys in this file or in GitHub.

# Your Anthropic API key. Leave it out and the Sermon Builder runs in demo mode.
ANTHROPIC_API_KEY=

# Optional: which AI model to use.
AI_MODEL=claude-sonnet-5-5

# --- Accounts (Supabase) ---
# From Supabase: Project Settings -> API. Leave these out and login stays hidden.
SUPABASE_URL=
# The "anon" / "public" key. NEVER use the "service_role" key here.
SUPABASE_ANON_KEY=

# Set to true to make the Sermon Builder members-only (recommended once your AI key is on).
REQUIRE_LOGIN=false
